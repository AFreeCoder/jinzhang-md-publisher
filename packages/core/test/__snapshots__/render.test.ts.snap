"<section style="font-family:-apple-system,BlinkMacSystemFont,&#x22;PingFang SC&#x22;,sans-serif;font-size:15px;line-height:1.9;color:#343a34;word-wrap:break-word">
<p style="margin:16px 0">一篇覆盖常用 Markdown 的验收样文。<strong style="font-weight:600;color:#51667d">重点，</strong>标点与强调应在一起。</p>
<p style="margin:16px 0"><img src="jz-img:0" alt="本地图片" style="max-width:100%;height:auto;display:block;margin:20px auto"></p>
<h2 style="font-size:19px;color:#51667d;margin:28px 0 18px;padding-bottom:8px;border-bottom:1px solid #e6e5df">列表与任务</h2>
<ul style="padding-left:24px;margin:16px 0"><li style="margin:7px 0">一级列表
<section style="margin-left:1em"><section style="margin:4px 0">• 二级列表
<section style="margin-left:1em"><section style="margin:4px 0">• 三级列表</section></section>
</section></section>
</li><li style="margin:7px 0;list-style:none;margin-left:-20px">☑ 已完成</li><li style="margin:7px 0;list-style:none;margin-left:-20px">☐ 待完成</li></ul>
<ol style="padding-left:24px;margin:16px 0"><li style="margin:7px 0">第一项</li><li style="margin:7px 0">第二项</li></ol>
<h3 style="font-size:17px;color:#51667d;margin:23px 0 14px">代码</h3>
<section style="overflow-x:auto;max-width:100%;margin:20px 0"><pre style="font-family:Menlo,Consolas,monospace;font-size:13px;line-height:1.7;white-space:pre;word-wrap:normal;padding:16px 18px;background:#282d35;color:#e2e5ea;border-radius:8px;margin:0"><code style="font-family:Menlo,Consolas,monospace;font-size:13px;padding:0;border-radius:0;background:transparent;color:#e2e5ea"><span style="color:#e892a0">function</span> <span style="color:#8dbbea">greet</span>(<span><span style="color:#a8cf9e">name</span>: <span style="color:#8dbbea">string</span></span>) {<br>  <span style="color:#e892a0">return</span> <span style="color:#a8cf9e">\`你好，<span>\${name}</span>\`</span>;<br>}</code></pre></section>
<h4 style="font-size:16px;margin:20px 0 12px">深层标题</h4>
<p style="margin:16px 0">知乎将此标题转换为加粗段落。</p>
<blockquote style="margin:22px 0;padding:12px 16px;border-left:3px solid #51667d;background:#f7f7f4;color:#70766a">
<p style="margin:10px 0;margin-top:0;margin-bottom:0">引用中保留文字与链接。</p>
</blockquote>

















<section style="overflow-x:auto;max-width:100%;margin:18px 0"><table border="1" cellpadding="8" bgcolor="#ffffff" style="min-width:280px;border-collapse:collapse;table-layout:fixed;font-size:13px;margin:0"><thead><tr><th style="background:#f2f3f0;font-weight:600">平台</th><th style="background:#f2f3f0;font-weight:600">能力</th></tr></thead><tbody><tr><td>微信公众号</td><td>样式与图片</td></tr><tr><td>知乎</td><td>结构与图片</td></tr></tbody></table></section>
<p style="margin:16px 0">正文带有脚注<sup style="font-size:11px;color:#51667d">[1]</sup>，也支持 <del>删除线</del>。</p>
<hr style="border:0;border-top:1px solid #dfdfd8;margin:28px 0">
<section><ul style="padding-left:24px;margin:16px 0"><li style="margin:7px 0"><a href="https://example.com/reading" style="color:#51667d;text-decoration:underline">继续阅读</a></li></ul></section>
<p style="color:#526d64;margin:16px 0">允许的内联颜色。</p>
<img src="jz-img:1" alt="原始 HTML 图片" style="max-width:100%;height:auto;display:block;margin:20px auto">
<section><h2 style="font-size:19px;color:#51667d;margin:28px 0 18px;padding-bottom:8px;border-bottom:1px solid #e6e5df">注释</h2>
<ol style="padding-left:24px;margin:16px 0"><li style="margin:7px 0">
<span>参考 <a href="https://github.com/AFreeCoder/jinzhang-md-publisher" style="color:#51667d;text-decoration:underline">项目仓库</a></span>
</li></ol>
</section></section>"
`;

