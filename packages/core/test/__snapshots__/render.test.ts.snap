</blockquote>

















<section style="overflow-x:auto;max-width:100%;margin:18px 0"><table style="width:100%;border-collapse:collapse;font-size:13px;table-layout:fixed;min-width:280px;white-space:normal;word-break:normal;overflow-wrap:anywhere;margin:0" border="1" cellpadding="8" cellspacing="0" bordercolor="#dddddd"><thead><tr><th bgcolor="#f2f3f0">平台</th><th bgcolor="#f2f3f0">能力</th></tr></thead><tbody><tr><td>微信公众号</td><td>样式与图片</td></tr><tr><td>知乎</td><td>结构与图片</td></tr></tbody></table></section>
